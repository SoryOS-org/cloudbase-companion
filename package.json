{
  "name": "soryos-code",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && ./node_modules/.bin/next dev -H 0.0.0.0",
    "start": "npm --prefix apps/web run start",
    "build": "npm --prefix apps/web run build",
    "build:dev": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test:engine": "bun run --cwd apps/web test:engine"
  }
}
